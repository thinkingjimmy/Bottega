{
  "name": "bottega-echo-extension",
  "version": "0.1.0",
  "description": "A minimal Bottega host package: it echoes what it is given, and asks the host one operation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "files": [
    "dist",
    "bottega.extension.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --legal-comments=none"
  },
  "dependencies": {
    "@bottega/sdk": "0.1.0"
  },
  "peerDependencies": {
    "zod": "~4.6.4"
  },
  "devDependencies": {
    "@bottega/testing": "0.1.0",
    "@types/node": "22.18.6",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "zod": "4.6.4"
  }
}
