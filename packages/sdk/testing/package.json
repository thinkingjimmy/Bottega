{
  "name": "@bottega/testing",
  "version": "0.1.0",
  "description": "Test a Bottega host package without a desktop: a fake host speaking the real host protocol, and the synthetic T1 cases. 0.x is a host protocol preview.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../build.mjs"
  },
  "peerDependencies": {
    "zod": "~4.6.4"
  },
  "dependencies": {
    "@bottega/contracts": "workspace:*",
    "@bottega/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "zod": "4.6.4"
  }
}
