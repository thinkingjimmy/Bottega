  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-chat/base-ui": "workspace:*",
    "@noble/hashes": "2.0.1",
    "zod": "4.6.4"
