    "./bases/encrypted/client": "./src/bases/encrypted/client/index.ts",
    "./apps/*": "./src/apps/*.ts",
    "./chats/*": "./src/chats/*.ts",
    "./remote/*": "./src/remote/*.ts",
    "./turns/*": "./src/turns/*.ts",
    "./search/*": "./src/search/*.ts",
    "./lifecycle/*": "./src/lifecycle/*.ts",
    "./projects/encrypted": "./src/projects/encrypted/index.ts",
    "./projects/encrypted/client": "./src/projects/encrypted/client.ts",
