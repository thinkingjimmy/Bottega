{
  "schema": "bottega.runtime-dependencies/v1",
  "description": "Single authority for every npm package the packaged desktop app resolves at runtime. package.json dependencies must equal this package set (scripts/check-dependency-manifest.mjs); metadata.ts, admission.ts and generate-app-gui-toolchain-metadata.mjs derive their tables from it; smoke-dist verifies the packaged ASAR against it. roles: main = required by out/main at runtime, appGui = resolved by the offline App GUI compiler from the packaged node_modules, adapter = ACP adapter chain. runtimeGates = toolchain slice membership; authorAdmission = which author import allowlist the bare package name belongs to (core or gate-3; base-ui/icons are informational because their allowlists are subpath-level in metadata.ts).",
  "packages": {
    "@agentclientprotocol/claude-agent-acp": {
      "version": "0.70.0",
      "roles": [
        "adapter"
      ]
    },
