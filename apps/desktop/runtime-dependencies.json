      "version": "1.6.2",
      "roles": [
        "adapter"
      ]
    },
    "@agentclientprotocol/sdk": {
      "version": "1.3.0",
      "roles": [
        "main",
        "adapter"
      ]
    },
    "@anthropic-ai/claude-agent-sdk": {
      "version": "0.3.232",
      "roles": [
        "main",
        "adapter"
      ],
      "mustEqualDependencyOf": "@agentclientprotocol/claude-agent-acp"
    },
    "@base-ui/react": {
      "version": "1.7.0",
      "roles": [
        "appGui"
      ],
      "runtimeGates": [
        "gate-1"
      ],
      "authorAdmission": "base-ui"
    },
    "@dnd-kit/core": {
      "version": "6.3.1",
