{
  "name": "@ai-chat/desktop",
  "version": "0.1.0",
  "description": "Bottega desktop workspace for local Codex, Claude Code, Kimi Code, and OpenCode CLIs",
  "author": "Jimmy Wong",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "i18n:check": "node scripts/check-i18n-copy.mjs",
    "pricing:update": "tsx scripts/update-model-pricing.ts",
    "pricing:check": "tsx scripts/update-model-pricing.ts --check",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && electron-vite build && node scripts/check-renderer-bundle.mjs",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.62.0",
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@agentclientprotocol/sdk": "1.3.0",
    "@ai-chat/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "ai": "^7.0.26",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "http-proxy": "^1.18.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^6.0.0",
    "nanoid": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grab": "0.1.48",
    "react-i18next": "^17.0.11",
    "react-router": "^7.18.1",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
