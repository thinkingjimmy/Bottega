{
  "name": "@ai-chat/desktop",
  "version": "0.1.1",
  "description": "Bottega desktop workspace for local Codex, Claude Code, Kimi Code, and OpenCode CLIs",
  "author": "Jimmy Wong",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "pricing:update": "tsx scripts/update-model-pricing.ts",
    "pricing:check": "tsx scripts/update-model-pricing.ts --check",
    "assets:windows-icon": "node scripts/generate-windows-icon.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "node scripts/check-dependency-manifest.mjs && pnpm typecheck && electron-vite build && node scripts/check-renderer-bundle.mjs --self-test",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:release:mac": "node scripts/release-signing-preflight.mjs && pnpm build && electron-builder --mac --arm64 --publish never -c.forceCodeSigning=true && node scripts/verify-macos-signing.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.232",
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/node": "4.3.2",
    "@tailwindcss/oxide": "4.3.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.8",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.10.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.1",
    "exceljs": "4.4.0",
    "http-proxy": "1.18.1",
    "i18next": "26.3.6",
    "lucide-react": "1.24.0",
    "nanoid": "6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.87.0",
    "sharp": "0.34.5",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-chat/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
    "@vitejs/plugin-react": "^5.2.0",
    "ai": "^7.0.26",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "maplibre-gl": "^6.0.0",
    "react-grab": "0.1.48",
    "react-i18next": "^17.0.11",
    "react-router": "^7.18.1",
    "tsx": "^4.23.1",
    "vite": "^7.3.6"
  }
}
