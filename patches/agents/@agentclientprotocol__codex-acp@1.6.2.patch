 #!/usr/bin/env node
+/* bottega-host-sandbox:start */
+/* Bottega: inside Bottega's host Seatbelt fence Codex's own Seatbelt cannot nest (sandbox_apply fails), and the host fence already
+   enforces the workspace mode and write roots. Only when Bottega's launcher wrapped this process (BOTTEGA_HOST_SANDBOX names the
+   fence) Codex's sandbox is off, and the fence is the boundary: "on-request" asks only what Codex asks beyond that sandbox (a
+   write outside the writable roots, an MCP tool approval), not every command. It becomes "untrusted" only where the fence cannot
+   keep the mode's promise or the reviewer is unknown: a read-only mode in a workspace-write fence, or no approvals_reviewer in
+   the CODEX_CONFIG Bottega launched with. Other policies pass through. */
+function bottegaReviewer() {
+  try { return JSON.parse(process.env.CODEX_CONFIG ?? "{}").approvals_reviewer ?? null; } catch { return null; }
+}
+function bottegaHostSandbox(params) {
+  const fence = process.env.BOTTEGA_HOST_SANDBOX;
+  if ((fence !== "seatbelt" && fence !== "seatbelt-read-only" && fence !== "seatbelt-read-only-full-access") || !params || typeof params !== "object") return params;
+  const next = { ...params };
+  const readOnlyMode = next.sandboxPolicy?.type === "readOnly";
+  if (next.sandboxPolicy) next.sandboxPolicy = { type: "dangerFullAccess" };
+  if (next.sandbox) next.sandbox = "danger-full-access";
+  if (next.approvalPolicy === "on-request") {
+    const unasked = readOnlyMode ? fence !== "seatbelt" : ["user", "auto_review"].includes(bottegaReviewer());
+    if (!unasked) next.approvalPolicy = "untrusted";
+  }
+  return next;
+}
+/* bottega-host-sandbox:end */
