+/* Bottega patch (OPT-24): shiki/core with the JavaScript regex engine, languages loaded on demand from shiki/langs, and only the
+   two GitHub themes, instead of the shiki root entry (bundle-full, the Oniguruma WASM and every theme). The token cache is keyed by
+   a hash of the whole code — blocks of equal length that differ in the middle no longer share tokens — and is a bounded LRU; an
+   evicted entry takes its pending callbacks with it. */
+import { createHighlighterCore } from "shiki/core";
+import { createJavaScriptRegexEngine } from "shiki/engine/javascript";
+import { bundledLanguages, bundledLanguagesInfo } from "shiki/langs";
+import githubLight from "shiki/dist/themes/github-light.mjs";
+import githubDark from "shiki/dist/themes/github-dark.mjs";
+
+const engine = createJavaScriptRegexEngine({ forgiving: true });
+const aliases = Object.fromEntries(bundledLanguagesInfo.flatMap((info) => (info.aliases ?? []).map((alias) => [alias, info.id])));
+const languages = new Set(Object.keys(bundledLanguages));
+const THEMES = { "github-light": githubLight, "github-dark": githubDark };
+const TOKEN_CACHE_LIMIT = 500;
+
+const canonical = (language) => { const name = language.trim().toLowerCase(); return aliases[name] ?? name; };
+const themeName = (theme) => (typeof theme === "string" ? theme : theme.name ?? "custom");
+const themeInput = (theme) => (typeof theme === "string" ? THEMES[theme] ?? THEMES["github-light"] : theme);
+/* 53-bit cyrb53 over the whole code: a collision would need equal language, themes, length and hash. */
+const hash = (text) => {
+  let h1 = 0xdeadbeef, h2 = 0x41c6ce57;
+  for (let i = 0; i < text.length; i++) { const ch = text.charCodeAt(i); h1 = Math.imul(h1 ^ ch, 2654435761); h2 = Math.imul(h2 ^ ch, 1597334677); }
+  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
+  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
+  return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(36);
+};
+
+const highlighters = new Map();
+const loadedLanguages = new Map();
+const highlighterFor = (themes) => {
+  const key = `${themeName(themes[0])}-${themeName(themes[1])}`;
+  if (!highlighters.has(key)) highlighters.set(key, createHighlighterCore({ themes: themes.map(themeInput), langs: [], engine }));
+  return highlighters.get(key);
+};
+const withLanguage = async (themes, language) => {
+  const highlighter = await highlighterFor(themes);
+  if (language === "text") return highlighter;
+  const key = `${themeName(themes[0])}-${themeName(themes[1])}:${language}`;
+  if (!loadedLanguages.has(key)) loadedLanguages.set(key, highlighter.loadLanguage(bundledLanguages[language]));
+  await loadedLanguages.get(key);
+  return highlighter;
+};
+
+function createCodePlugin(options = {}) {
+  const themes = options.themes ?? ["github-light", "github-dark"];
+  const tokens = new Map();
+  const pending = new Map();
+  const remember = (key, value) => {
+    tokens.delete(key);
+    tokens.set(key, value);
+    while (tokens.size > TOKEN_CACHE_LIMIT) {
+      const oldest = tokens.keys().next().value;
+      tokens.delete(oldest);
+      pending.delete(oldest);
+    }
+  };
+  return {
+    name: "shiki",
+    type: "code-highlighter",
+    supportsLanguage: (language) => languages.has(canonical(language)),
+    getSupportedLanguages: () => Array.from(languages),
+    getThemes: () => themes,
+    highlight({ code, language, themes: requested }, callback) {
+      const lang = canonical(language), names = [themeName(requested[0]), themeName(requested[1])];
+      const key = `${lang}:${names[0]}:${names[1]}:${code.length}:${hash(code)}`;
+      if (tokens.has(key)) { const value = tokens.get(key); remember(key, value); return value; }
+      if (callback) { if (!pending.has(key)) pending.set(key, new Set()); pending.get(key).add(callback); }
+      const effective = languages.has(lang) ? lang : "text";
+      withLanguage(requested, effective).then((highlighter) => {
+        const result = highlighter.codeToTokens(code, { lang: effective, themes: { light: names[0], dark: names[1] } });
+        remember(key, result);
+        const waiting = pending.get(key);
+        pending.delete(key);
+        if (waiting) for (const notify of waiting) notify(result);
+      }).catch((error) => {
+        console.error("[Streamdown Code] Failed to highlight code:", error);
+        pending.delete(key);
+      });
+      return null;
+    },
+  };
+}
+
+const code = createCodePlugin();
+export { code, createCodePlugin };
