{
  "name": "bottega",
  "version": "0.2.4",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ai-chat/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dist": "pnpm --filter @ai-chat/desktop dist",
    "lint": "eslint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
